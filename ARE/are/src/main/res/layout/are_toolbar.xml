<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:colorPickerView="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.chinalwb.are.colorpicker.ColorPickerView
        android:id="@+id/rteColorPalette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/background_light"
        android:padding="10dp"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        colorPickerView:colorViewHeight="30dp"
        colorPickerView:colorViewWidth="30dp"
        colorPickerView:colorViewMarginLeft="2dp"
        colorPickerView:colorViewMarginRight="2dp"
        colorPickerView:colorViewCheckedType="checkMark"
        colorPickerView:colors="@array/colorPickerColors"
        />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/are_toolbar_background">

            <ImageView
                android:id="@+id/rteEmoji"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_emoji"
                android:background="@drawable/are_tool_item_background"
                android:visibility="gone"
                />

            <ImageView
                android:id="@+id/rteFontsize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_fontsize"
                android:background="@drawable/are_tool_item_background"
                android:visibility="visible"
                />

            <ImageView
                android:id="@+id/rteFontface"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_fontface"
                android:background="@drawable/are_tool_item_background"
                android:visibility="gone"
                />

            <ImageView
                android:id="@+id/rteBold"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_bold"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteItalic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_italic"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteUnderline"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_underline"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteStrikethrough"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_strikethrough"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteHr"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_hr"
                android:background="@drawable/are_tool_item_background" />


            <ImageView
                android:id="@+id/rteSubscript"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_subscript"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteSuperscript"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_superscript"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteQuote"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_quote"
                android:background="@drawable/are_tool_item_background" />


            <ImageView
                android:id="@+id/rteFontColor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_foregroundcolor"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteBackground"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_background"
                android:background="@drawable/are_tool_item_background"
                />

            <ImageView
                android:id="@+id/rteLink"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_link"
                android:background="@drawable/are_tool_item_background"
                />

            <ImageView
                android:id="@+id/rteListNumber"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_listnumber"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteListBullet"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_listbullet"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteIndentRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_indentright"
                android:background="@drawable/are_tool_item_background"
                android:visibility="gone"
                 />

            <ImageView
                android:id="@+id/rteIndentLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_indentleft"
                android:background="@drawable/are_tool_item_background"
                android:visibility="gone"
                />

            <ImageView
                android:id="@+id/rteAlignLeft"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_alignleft"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteAlignCenter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_aligncenter"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteAlignRight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_alignright"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteInsertImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_image"
                android:background="@drawable/are_tool_item_background" />

            <ImageView
                android:id="@+id/rteInsertVideo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_video"
                android:background="@drawable/are_tool_item_background"
                />

            <ImageView
                android:id="@+id/rteAt"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/are_ic_at"
                android:background="@drawable/are_tool_item_background"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:id="@+id/rteEmojiPanel"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:visibility="gone"
        android:gravity="center"
        android:paddingTop="10dp"
        android:orientation="horizontal">

    </LinearLayout>
</merge>